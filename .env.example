# PostgreSQL — add the connection string from your provider (for example Supabase).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Choose Clerk OR Auth.js. Clerk values are available from your Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Media provider: Cloudinary (or swap to UploadThing when provisioning).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payments. Configure each provider after opening merchant accounts.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""

# Transactional email (Resend).
RESEND_API_KEY=""
